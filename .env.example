# ===================== Mishanya: локальная конфигурация =====================
# Скопируйте этот файл в .env (setup.bat делает это автоматически) и заполните.
# Файл .env содержит секреты: не публикуйте его и не отправляйте никому.

# Токен бота: Discord Developer Portal -> ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=

# Пароль для входа в веб-панель (минимум 8 символов)
PANEL_PASSWORD=

# Ваш Discord ID (необязательно, отображается в диагностике)
OWNER_ID=

# Адрес и порт панели. 127.0.0.1 = доступ только с этого компьютера.
PANEL_HOST=127.0.0.1
PANEL_PORT=8777

# Открыть панель за пределы компьютера можно только осознанно:
# измените PANEL_HOST и установите ALLOW_REMOTE_PANEL=true (не рекомендуется без HTTPS).
ALLOW_REMOTE_PANEL=false

# Открывать панель в браузере при запуске
OPEN_BROWSER=true

# Уровень подробности журнала: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Сколько часов действует вход в панель
SESSION_HOURS=72

# Необязательно: другие папки для данных и резервных копий
# DATA_DIR=
# BACKUP_DIR=

# Необязательно: ключ DeepSeek для модуля «Болтовня» (бот сам вмешивается в разговор).
# Получить: https://platform.deepseek.com/api_keys. Можно вставить и в панели — раздел «Болтовня».
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Необязательно: распознавание речи, чтобы бот слушал голосовые каналы (/listen).
# Пусто — используются DEEPSEEK_API_KEY и DEEPSEEK_BASE_URL. Сам DeepSeek речь не распознаёт,
# подойдёт OpenAI-совместимый сервис с /audio/transcriptions, например https://api.inferhold.com/v1
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=gpt-4o-transcribe

# Необязательно: токен GitHub, если репозиторий с ботом закрытый — без него обновление не скачается.
# github.com → Settings → Developer settings → Fine-grained tokens → доступ к одному репозиторию, Contents: Read-only.
# MISHANYA_UPDATE_TOKEN=

# Необязательно: модель со зрением, чтобы бот смотрел скриншоты (можно задать в панели — «Болтовня» → «Модели ИИ»).
# Пусто — картинки не смотрит. Ключ и адрес по умолчанию те же, что DEEPSEEK_*. Пример для Inferhold: gpt-4o-mini
# VISION_MODEL=
# VISION_API_KEY=
# VISION_BASE_URL=
