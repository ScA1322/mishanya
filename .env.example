# ===================== Mishanya: локальная конфигурация =====================
# Скопируйте этот файл в .env (setup.bat делает это автоматически) и заполните.
# Файл .env содержит секреты: не публикуйте его и не отправляйте никому.

# Токен бота: Discord Developer Portal -> ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=

# Пароль для входа в веб-панель (минимум 8 символов)
PANEL_PASSWORD=

# Ваш Discord ID (необязательно, отображается в диагностике)
OWNER_ID=

# Адрес и порт панели. 127.0.0.1 = доступ только с этого компьютера.
PANEL_HOST=127.0.0.1
PANEL_PORT=8777

# Открыть панель за пределы компьютера можно только осознанно:
# измените PANEL_HOST и установите ALLOW_REMOTE_PANEL=true (не рекомендуется без HTTPS).
ALLOW_REMOTE_PANEL=false

# Открывать панель в браузере при запуске
OPEN_BROWSER=true

# Уровень подробности журнала: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Сколько часов действует вход в панель
SESSION_HOURS=72

# Необязательно: другие папки для данных и резервных копий
# DATA_DIR=
# BACKUP_DIR=
