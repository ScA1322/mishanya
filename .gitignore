# Секреты и локальные данные
.env
data/
backups/*
!backups/.gitkeep

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Frontend (собранная папка dist хранится в проекте, чтобы Node.js не был обязателен)
frontend/node_modules/
frontend/*.tsbuildinfo

# Флаг автообновления: start.bat переустановит зависимости
.update-deps
